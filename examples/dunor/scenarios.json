[
  {
    "name": "novio: alquiler o diseño y cita",
    "turns": [
      {
        "text": "hola",
        "expect": {
          "intent": "saludo"
        }
      },
      {
        "text": "me caso en diciembre y busco traje, ustedes alquilan o hacen a la medida?",
        "expect": {
          "intent": "compra",
          "includesAny": [
            "alquiler",
            "Alquiler",
            "medida"
          ],
          "noGreeting": true
        }
      },
      {
        "text": "y cuánto cuesta el alquiler?",
        "expect": {
          "includesAny": [
            "cita",
            "Cita",
            "depende",
            "define",
            "confirm"
          ],
          "excludes": [
            "$",
            ".000"
          ],
          "noGreeting": true
        }
      },
      {
        "text": "listo, agendemos",
        "expect": {
          "intent": "cita",
          "engine": "template",
          "includesAny": [
            "nombre",
            "1)"
          ]
        }
      },
      {
        "text": "Andrés Peña",
        "expect": {
          "intent": "cita",
          "engine": "template",
          "includesAny": [
            "1)",
            "2)"
          ]
        }
      },
      {
        "text": "la 2",
        "expect": {
          "intent": "cita",
          "engine": "template",
          "includesAny": [
            "número"
          ]
        }
      },
      {
        "text": "3001234567",
        "expect": {
          "intent": "cita",
          "engine": "template",
          "includesAny": [
            "confirmo"
          ]
        }
      },
      {
        "text": "dale",
        "expect": {
          "intent": "cita",
          "engine": "template",
          "includesAny": [
            "300 123 4567"
          ]
        }
      }
    ]
  },
