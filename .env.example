# --- Ollama ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=gemma4:e4b
GATE_MODEL=              # vacío = usa CHAT_MODEL
EMBED_MODEL=bge-m3
NUM_CTX=8192             # mismo valor para gate y respuesta: si cambia, Ollama recarga el modelo
KEEP_ALIVE=1h            # cuánto quedan los modelos en memoria entre mensajes (-1 = siempre)
TEMPERATURE=0.7

# --- Motores (por rol) ---
LLM_ENGINE=router        # router = reparte entre LIGHT_ENGINE y HEAVY_ENGINE; ollama | apple | openai fuerzan uno solo
LIGHT_ENGINE=apple       # saludos, info de tienda, compras puntuales (rápido)
HEAVY_ENGINE=ollama      # recomendar, comparar, detalles ("trabajo de adulto"); puede ser openai
GATE_ENGINE=ollama       # clasificación de intención (JSON estructurado)
ANALYSIS_ENGINE=         # análisis comercial por turno; vacío = GATE_ENGINE
APPLE_SIDECAR_BIN=./sidecar/bin/xencrm-afm   # compilar con: pnpm build:sidecar (macOS 26+, Apple Intelligence activo)
APPLE_MAX_PROMPT_TOKENS=2800               # por encima de esto el turno va al motor pesado (ventana de Apple: 4096)

# --- OpenAI (opcional; también sirve cualquier API compatible con OPENAI_BASE_URL) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modelo por rol cuando el rol usa openai (vacío = OPENAI_MODEL). Lo que usa DUNOR (2026-09-21):
# LLM_ENGINE=router, LIGHT/HEAVY/GATE/ANALYSIS_ENGINE=openai, OPENAI_MODEL=gpt-5.4-mini, OPENAI_MODEL_HEAVY=gpt-5.4,
# OPENAI_MODEL_ANALYSIS=gpt-5.4-mini (también se probó gpt-5.5 para el análisis; el equipo eligió gpt-5.4-mini)
OPENAI_MODEL_LIGHT=
OPENAI_MODEL_HEAVY=
OPENAI_MODEL_GATE=
OPENAI_MODEL_ANALYSIS=
# Esfuerzo de razonamiento por rol (none | minimal | low | medium | high; vacío = el del modelo). Solo en modelos
# de razonamiento (gpt-5, gpt-5.5…): sus tokens de razonamiento se cobran como salida.
OPENAI_EFFORT_LIGHT=
OPENAI_EFFORT_HEAVY=
OPENAI_EFFORT_GATE=
OPENAI_EFFORT_ANALYSIS=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Claude (Anthropic): el respaldo (opcional) ---
# Con la llave puesta, cuando el motor de un rol falla (caído, sin saldo, llave revocada) contesta Claude.
# No se asigna a roles: es el suplente. Haiku para lo de todos los días; Sonnet para lo específico y para
# clasificar, que no baja de categoría ni siendo suplente. Para probarlo de titular con las frases de siempre:
#   pnpm test:scenarios --engine=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL_LIGHT=
ANTHROPIC_MODEL_HEAVY=claude-sonnet-5-5
ANTHROPIC_MODEL_GATE=claude-sonnet-5-5
ANTHROPIC_MODEL_ANALYSIS=

# --- Voz: agentes conversacionales con Grok (xAI Voice Agent API) ---
# Con la llave, los agentes con el canal «Voz» (Configuración › Agentes) atienden llamadas desde la ventana de
# chat del sitio. El servidor hace de puente: la llave nunca llega al navegador.
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime   # solo para pruebas con un servidor de mentira
# Teléfono por SIP (3CX, Twilio, Telnyx u otra troncal): tu troncal manda las llamadas a sip:<número>@sip.voice.x.ai
# y xAI le avisa a XENCRM en <PUBLIC_URL>/voz/sip. Al registrar el número en xAI (origin byo_trunk) te dan el secreto
# con que firma ese aviso (whsec_…): va aquí. El desvío es a dónde se pasa la llamada para hablar con una persona.
XAI_SIP_SECRETO=
XAI_SIP_DESVIO=              # ej: sip:100@empresa.3cx.us  o  tel:+573001234567

# --- LM Studio (opcional): su servidor local habla como OpenAI ---
# En LM Studio: Developer › Start server. No pide llave y no cuesta. Hay que nombrar el modelo cargado (el id que
# sale en Configuración › Modelos de IA › Probar conexión). Se asigna a un rol con LIGHT/HEAVY/GATE/ANALYSIS_ENGINE=lmstudio.
LMSTUDIO_URL=            # vacío = http://localhost:1234/v1
LMSTUDIO_MODEL=

# --- Otra API compatible con OpenAI (opcional): OpenRouter, Groq, Together, un vLLM propio… ---
# Su dirección (la que termina en /v1), su llave si la pide y el modelo. Cuenta como de pago para el tope de gasto,
# aunque no se sepa su precio. Se asigna a un rol con <ROL>_ENGINE=compat.
COMPAT_URL=
COMPAT_API_KEY=
COMPAT_MODEL=
COMPAT_NOMBRE=           # cómo se llama en la pantalla, sin espacios (p. ej. OpenRouter)

# --- Tablero (http://localhost:3000/admin) ---
ADMIN_TOKEN=             # vacío = se genera uno aleatorio al arrancar y se imprime en consola

# --- Calendario ---
CALENDAR_TOKEN=          # secreto del enlace de suscripción a las citas (vacío = derivado de ADMIN_TOKEN)
CALENDAR_BUSY_ICS=       # coma-separado: direcciones secretas iCal del dueño (Google: Configuración → tu calendario →
                         # Integrar el calendario → Dirección secreta en formato iCal). Sus eventos bloquean la agenda.

# --- WhatsApp Cloud API (Meta, oficial; alternativa a Baileys) ---
# También se llenan desde el tablero (Canales › WhatsApp oficial › Credenciales): se verifican con Meta y se
# escriben aquí mismo.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=       # el que registres en el panel de Meta para verificar el webhook
META_APP_SECRET=         # para validar la firma X-Hub-Signature-256 de cada webhook
META_API_VERSION=v26.0       # la más nueva al 2026-09-22 (developers.facebook.com/docs/graph-api/changelog)

# --- Servidor web / widget / MCP ---
PORT=3000
WEB_ENABLED=true
MCP_ENABLED=true
ALLOWED_ORIGINS=*        # coma-separado, ej: https://mitienda.com,https://www.mitienda.com
PUBLIC_URL=              # URL pública (túnel), ej: https://xencrm.mitienda.com — se usa en el snippet del widget

# --- WhatsApp (Baileys) ---
WHATSAPP_ENABLED=true       # valor inicial: después se enciende o apaga desde el tablero (Canales)
WHATSAPP_AUTH_DIR=./auth
WHATSAPP_IGNORE_GROUPS=true
WHATSAPP_ALLOWED_NUMBERS=   # coma-separado sin '+', ej: 573001234567,573009876543 (vacío = todos)
DEBOUNCE_MS=1500            # espera para agrupar mensajes seguidos del mismo cliente

# --- Memoria ---
DB_PATH=./data/xencrm.db
HISTORY_TURNS=8

# --- Otro cliente u otra copia desde la misma carpeta (pruebas aisladas) ---
# XENCRM_CONFIG=xencrm.config.json     # archivo de configuración del negocio
# XENCRM_ENV_FILE=.env               # este archivo (se lee al arrancar y aquí escribe el tablero)
